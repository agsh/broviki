# Relative file: works for migrate/client. Prisma Studio needs file:///abs/path
# (see prisma:studio script). Do not use file://./dev.db — migrate resolves it wrong.
DATABASE_URL="file:./dev.db"
PORT=3001
# Comma-separated browser origins for HTTP CORS + socket.io (/camera-events)
WEB_ORIGIN=http://localhost:3000
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_WEBRTC_PORT=8889
